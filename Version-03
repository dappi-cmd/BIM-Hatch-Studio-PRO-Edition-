    def create_entry(self, parent, variable, width, callback=None):
        """Create entry field"""
        entry = tk.Entry(parent, textvariable=variable, width=width, bg=self.secondary_panel,
                        fg=self.text_color, relief=tk.FLAT, insertbackground=self.accent_color)
        if callback:
            variable.trace_add("write", callback)
        return entry

    def save_state(self):
        """Save state for undo"""
        self.history.append([line.copy() for line in self.lines])
        self.redo_history.clear()
        if len(self.history) > 100:
            self.history.pop(0)

    def undo(self, event=None):
        """Undo"""
        if self.history:
            self.redo_history.append([line.copy() for line in self.lines])
            self.lines = self.history.pop()
            self.redraw_all()
            self.generate_pat()
            self.update_status("Undo", self.success_color)

    def redo(self, event=None):
        """Redo"""
        if self.redo_history:
            self.history.append([line.copy() for line in self.lines])
            self.lines = self.redo_history.pop()
            self.redraw_all()
            self.generate_pat()
            self.update_status("Redo", self.success_color)

    def start_pan(self, event):
        """Start pan"""
        self.pan_start_x = event.x
        self.pan_start_y = event.y

    def do_pan(self, event):
        """Pan"""
        dx = (event.x - self.pan_start_x) / self.zoom_level
        dy = (event.y - self.pan_start_y) / self.zoom_level
        self.pan_x -= dx
        self.pan_y -= dy
        self.redraw_all()

    def do_zoom(self, event):
        """Zoom"""
        if event.num == 5 or event.delta < 0:
            self.zoom_level *= 0.85
        else:
            self.zoom_level *= 1.15
        self.zoom_level = max(0.1, min(5.0, self.zoom_level))
        self.redraw_all()

    def get_grid_size(self):
        try:
            return max(10, self.grid_size_mm.get())
        except:
            return 100

    def get_canvas_dims(self):
        try:
            return max(100, self.canvas_width_mm.get()), max(100, self.canvas_height_mm.get())
        except:
            return 4000, 4000

    def draw_grid(self):
        """Draw grid with centerlines"""
        self.canvas.delete("grid")
        self.canvas.delete("bounds")
        
        if not self.grid_visible.get():
            return
        
        grid = self.get_grid_size()
        cw, ch = self.get_canvas_dims()
        
        # Bounds
        self.canvas.create_rectangle(0, 0, cw, ch, outline=self.grid_light, width=3, dash=(6,3), tags="bounds")
        
        # Main grid
        for i in range(0, cw + 1, grid):
            self.canvas.create_line(i, 0, i, ch, fill=self.grid_color, tags="grid", dash=(2,2))
        for i in range(0, ch + 1, grid):
            self.canvas.create_line(0, i, cw, i, fill=self.grid_color, tags="grid", dash=(2,2))
        
        # Centerlines
        self.canvas.create_line(cw/2, 0, cw/2, ch, fill=self.grid_light, tags="grid", width=2, dash=(4,4))
        self.canvas.create_line(0, ch/2, cw, ch/2, fill=self.grid_light, tags="grid", width=2, dash=(4,4))
        
        self.canvas.tag_lower("grid")
        self.canvas.tag_lower("bounds")

    def snap(self, val):
        if not self.snap_enabled.get():
            return val
        grid = self.get_grid_size()
        return round(val / grid) * grid

    def on_mouse_move(self, event):
        cx, cy = self.canvas.canvasx(event.x), self.canvas.canvasy(event.y)
        cx, cy = self.snap(cx), self.snap(cy)
        self.dim_label.config(text=f"{int(cx)}, {int(cy)} mm")
        self.dim_label.place(x=event.x + 15, y=event.y + 15)

    def on_press(self, event):
        cx, cy = self.canvas.canvasx(event.x), self.canvas.canvasy(event.y)
        self.start_x, self.start_y = self.snap(cx), self.snap(cy)
        
        tool = self.current_tool.get()
        if tool == "LINE":
            self.current_shape_id = self.canvas.create_line(self.start_x, self.start_y, self.start_x,
                                                            self.start_y, fill=self.line_color, width=2)
        elif tool == "RECT":
            self.current_shape_id = self.canvas.create_rectangle(self.start_x, self.start_y, self.start_x,
                                                                 self.start_y, outline=self.line_color, width=2)
        elif tool == "CIRCLE":
            self.current_shape_id = self.canvas.create_oval(self.start_x, self.start_y, self.start_x,
                                                            self.start_y, outline=self.line_color, width=2)
        elif tool == "ERASER":
            self.erase_near_point(cx, cy)

    def erase_near_point(self, cx, cy):
        """Erase near point"""
        closest, min_dist = None, float('inf')
        for line in self.lines:
            x1, y1, x2, y2 = line['coords']
            l2 = (x2-x1)**2 + (y2-y1)**2
            if l2 == 0:
                d = math.hypot(cx-x1, cy-y1)
            else:
                t = max(0, min(1, ((cx-x1)*(x2-x1) + (cy-y1)*(y2-y1)) / l2))
                d = math.hypot(cx-(x1+t*(x2-x1)), cy-(y1+t*(y2-y1)))
            if d < 30 and d < min_dist:
                min_dist, closest = d, line
        
        if closest:
            self.save_state()
            self.lines.remove(closest)
            self.redraw_all()
            self.generate_pat()

    def on_drag(self, event):
        if self.current_shape_id:
            cx, cy = self.canvas.canvasx(event.x), self.canvas.canvasy(event.y)
            end_x, end_y = self.snap(cx), self.snap(cy)
            
            if self.is_shift_pressed and self.current_tool.get() == "LINE":
                dx, dy = end_x - self.start_x, end_y - self.start_y
                if abs(dx) > abs(dy):
                    end_y = self.start_y
                else:
                    end_x = self.start_x
            
            tool = self.current_tool.get()
            if tool in ["LINE", "RECT"]:
                self.canvas.coords(self.current_shape_id, self.start_x, self.start_y, end_x, end_y)
            elif tool == "CIRCLE":
                r = math.hypot(end_x - self.start_x, end_y - self.start_y)
                self.canvas.coords(self.current_shape_id, self.start_x - r, self.start_y - r,
                                  self.start_x + r, self.start_y + r)

    def on_release(self, event):
        if not self.current_shape_id:
            return
            
        self.save_state()
        cx, cy = self.canvas.canvasx(event.x), self.canvas.canvasy(event.y)
        end_x, end_y = self.snap(cx), self.snap(cy)
        
        if self.is_shift_pressed and self.current_tool.get() == "LINE":
            dx, dy = end_x - self.start_x, end_y - self.start_y
            if abs(dx) > abs(dy):
                end_y = self.start_y
            else:
                end_x = self.start_x
        
        if self.start_x != end_x or self.start_y != end_y:
            tool = self.current_tool.get()
            if tool == "LINE":
                self.lines.append({'coords': (self.start_x, self.start_y, end_x, end_y)})
            elif tool == "RECT":
                for coord in [(self.start_x, self.start_y, end_x, self.start_y),
                             (end_x, self.start_y, end_x, end_y),
                             (end_x, end_y, self.start_x, end_y),
                             (self.start_x, end_y, self.start_x, self.start_y)]:
                    self.lines.append({'coords': coord})
            elif tool == "CIRCLE":
                r = math.hypot(end_x - self.start_x, end_y - self.start_y)
                pts = [(self.start_x + r * math.cos(2*math.pi*i/32),
                       self.start_y + r * math.sin(2*math.pi*i/32)) for i in range(33)]
                for i in range(32):
                    self.lines.append({'coords': (pts[i][0], pts[i][1], pts[i+1][0], pts[i+1][1])})
        else:
            self.history.pop()
        
        self.canvas.delete(self.current_shape_id)
        self.current_shape_id = None
        self.redraw_all()
        self.generate_pat()

    def gen_brick(self):
        self.save_state()
        self.lines.clear()
        cw, ch = self.get_canvas_dims()
        bw, bh = self.brick_w.get(), self.brick_h.get()
        if bw <= 0 or bh <= 0: return
        
        for y in range(0, ch + 1, bh):
            self.lines.append({'coords': (0, y, cw, y)})
        offset = False
        for y in range(0, ch, bh):
            start_x = bw // 2 if offset else 0
            for x in range(start_x, cw + 1, bw):
                self.lines.append({'coords': (x, y, x, y + bh)})
            offset = not offset
        self.redraw_all()
        self.generate_pat()

    def gen_herringbone(self):
        self.save_state()
        self.lines.clear()
        cw, ch = self.get_canvas_dims()
        bw, bh = self.brick_w.get(), self.brick_h.get()
        if bw <= 0 or bh <= 0: return
        
        for row in range(0, ch, int(bh)):
            for col in range(0, cw, int(bw)):
                if (row // int(bh) + col // int(bw)) % 2 == 0:
                    self.lines.append({'coords': (col, row, col + bw, row + bh)})
                else:
                    self.lines.append({'coords': (col + bw, row, col, row + bh)})
        self.redraw_all()
        self.generate_pat()

    def gen_hexagon(self):
        self.save_state()
        self.lines.clear()
        cw, ch = self.get_canvas_dims()
        radius = self.brick_w.get() / 2
        if radius <= 0: return
        
        dy, dx = math.sqrt(3) * radius, 3/2 * radius
        for row in range(int(ch/dy) + 2):
            for col in range(int(cw/dx) + 2):
                x, y = col * dx, row * dy
                if col % 2 == 1: y += dy/2
                pts = [(x + radius * math.cos(math.radians(a)), 
                       y + radius * math.sin(math.radians(a))) for a in [0, 60, 120, 180, 240, 300]]
                for i in range(6):
                    self.lines.append({'coords': (pts[i][0], pts[i][1], pts[(i+1)%6][0], pts[(i+1)%6][1])})
        self.redraw_all()
        self.generate_pat()

    def gen_grid(self):
        self.save_state()
        self.lines.clear()
        cw, ch = self.get_canvas_dims()
        size = self.brick_w.get()
        if size <= 0: return
        for x in range(0, cw + 1, size):
            self.lines.append({'coords': (x, 0, x, ch)})
        for y in range(0, ch + 1, size):
            self.lines.append({'coords': (0, y, cw, y)})
        self.redraw_all()
        self.generate_pat()

    def gen_diamond(self):
        self.save_state()
        self.lines.clear()
        cw, ch = self.get_canvas_dims()
        size = self.brick_w.get()
        if size <= 0: return
        half = size // 2
        for y in range(0, ch, size):
            for x in range(0, cw, size):
                pts = [(x+half, y), (x+size, y+half), (x+half, y+size), (x, y+half)]
                for i in range(4):
                    self.lines.append({'coords': (pts[i][0], pts[i][1], pts[(i+1)%4][0], pts[(i+1)%4][1])})
        self.redraw_all()
        self.generate_pat()

    def gen_wave(self):
        self.save_state()
        self.lines.clear()
        cw, ch = self.get_canvas_dims()
        wl, amp = self.brick_w.get(), self.brick_h.get()
        if wl <= 0: return
        for y in range(0, ch, amp*2):
            for x in range(0, cw, wl):
                pts = [(x + (i/20)*wl, y + amp*math.sin((i/20)*math.pi)) for i in range(21)]
                for i in range(20):
                    self.lines.append({'coords': (pts[i][0], pts[i][1], pts[i+1][0], pts[i+1][1])})
        self.redraw_all()
        self.generate_pat()

    def gen_chevron(self):
        self.save_state()
        self.lines.clear()
        cw, ch = self.get_canvas_dims()
        bw, bh = self.brick_w.get(), self.brick_h.get()
        if bw <= 0 or bh <= 0: return
        for row in range(0, ch, bh):
            for col in range(0, cw, bw):
                mid = col + bw/2
                self.lines.append({'coords': (col, row, mid, row+bh)})
                self.lines.append({'coords': (mid, row+bh, col+bw, row)})
        self.redraw_all()
        self.generate_pat()

    def gen_basketweave(self):
        self.save_state()
        self.lines.clear()
        cw, ch = self.get_canvas_dims()
        bw, bh = self.brick_w.get(), self.brick_h.get()
        if bw <= 0 or bh <= 0: return
        for y in range(0, ch, bh*2):
            for x in range(0, cw, bw*2):
                self.lines.append({'coords': (x, y, x+bw, y)})
                self.lines.append({'coords': (x, y+bh, x+bw, y+bh)})
                self.lines.append({'coords': (x+bw, y, x+bw, y+bh)})
        self.redraw_all()
        self.generate_pat()

    def redraw_all(self):
        self.canvas.delete("all")
        self.draw_grid()
        for line in self.lines:
            x1, y1, x2, y2 = line['coords']
            self.canvas.create_line(x1, y1, x2, y2, fill=self.line_color, width=self.line_weight.get())

    def clear_canvas(self):
        if len(self.lines) > 0:
            if messagebox.askyesno("Clear", f"Clear {len(self.lines)} lines?"):
                self.save_state()
                self.lines.clear()
                self.redraw_all()
                self.generate_pat()

    def apply_transformation(self):
        if not self.lines: return
        self.save_state()
        angle_rad = math.radians(self.rotation_angle.get())
        ox, oy = self.offset_x.get(), self.offset_y.get()
        scale = self.global_scale.get()
        for line in self.lines:
            x1, y1, x2, y2 = line['coords']
            cx, cy = (x1+x2)/2, (y1+y2)/2
            x1_rot = (x1-cx)*math.cos(angle_rad) - (y1-cy)*math.sin(angle_rad) + cx
            y1_rot = (x1-cx)*math.sin(angle_rad) + (y1-cy)*math.cos(angle_rad) + cy
            x2_rot = (x2-cx)*math.cos(angle_rad) - (y2-cy)*math.sin(angle_rad) + cx
            y2_rot = (x2-cx)*math.sin(angle_rad) + (y2-cy)*math.cos(angle_rad) + cy
            line['coords'] = (x1_rot*scale + ox, y1_rot*scale + oy, x2_rot*scale + ox, y2_rot*scale + oy)
        self.redraw_all()
        self.generate_pat()

    def analyze_pattern(self):
        self.analysis_text.delete("1.0", tk.END)
        if not self.lines:
            self.analysis_text.insert(tk.END, "No pattern")
            return
        
        total_len = sum(math.sqrt((x2-x1)**2 + (y2-y1)**2) for x1, y1, x2, y2 in [l['coords'] for l in self.lines])
        analysis = f"""ANALYSIS
Total Lines: {len(self.lines)}
Total Length: {total_len:.0f}mm
Average: {total_len/len(self.lines):.0f}mm
Canvas: {self.canvas_width_mm.get()}x{self.canvas_height_mm.get()}mm
Grid: {self.get_grid_size()}mm
Type: {self.pattern_type.get()}
"""
        self.analysis_text.insert(tk.END, analysis)

    def load_library_pattern(self):
        sel = self.library_listbox.curselection()
        if not sel: return
        item = self.library_listbox.get(sel[0])
        map_dict = {
            "🧱 Brick - Running Bond": self.gen_brick,
            "⌘ Wood - Herringbone": self.gen_herringbone,
            "⬡ Tile - Hexagon": self.gen_hexagon,
            "⊞ Grid - Square": self.gen_grid,
            "◇ Stone - Diamond": self.gen_diamond,
        }
        if map_dict.get(item):
            map_dict[item]()

    def generate_pat(self):
        code = f"*{self.pattern_name.get()}, Generated by BIM Hatch Studio V2.0\n"
        code += f";%TYPE={self.pattern_type.get()}\n"
        code += f";%LW={self.line_weight.get()}\n"
        
        cw, ch = self.get_canvas_dims()
        for line in self.lines:
            x1, y1, x2, y2 = line['coords']
            dx, dy = x2-x1, y2-y1
            if dx == 0 and dy == 0: continue
            angle = math.degrees(math.atan2(-dy, dx)) % 360
            length = math.sqrt(dx**2 + dy**2)
            repeat_x = cw if abs(dx) < 0.01 else 0
            repeat_y = ch if abs(dy) < 0.01 else 0
            code += f"{angle:.2f},{x1:.2f},{-y1:.2f},{repeat_x:.2f},{repeat_y:.2f},{length:.2f},-{length:.2f}\n"
        
        self.text_output.delete("1.0", tk.END)
        self.text_output.insert(tk.END, code)
        self.update_status(f"Pattern: {len(self.lines)} lines")

    def update_status(self, msg, color=None):
        zoom = int(self.zoom_level * 100)
        status = f"{msg} | Lines: {len(self.lines)} | Grid: {self.get_grid_size()}mm | Zoom: {zoom}%"
        self.status_label.config(text=status, fg=color or self.success_color)

    def copy_pat_code(self):
        self.root.clipboard_clear()
        self.root.clipboard_append(self.text_output.get("1.0", tk.END))

    def export_pat(self, event=None):
        fp = filedialog.asksaveasfilename(defaultextension=".pat", initialfile=f"{self.pattern_name.get()}.pat",
                                         filetypes=[("PAT", "*.pat"), ("TXT", "*.txt"), ("All", "*.*")])
        if fp:
            try:
                with open(fp, 'w') as f:
                    f.write(self.text_output.get("1.0", tk.END).strip())
                messagebox.showinfo("Success", f"Exported: {os.path.basename(fp)}")
            except Exception as e:
                messagebox.showerror("Error", str(e))

    def save_project(self, event=None):
        fp = filedialog.asksaveasfilename(defaultextension=".hatch", initialfile=f"{self.pattern_name.get()}.hatch",
                                         filetypes=[("HATCH", "*.hatch"), ("JSON", "*.json"), ("All", "*.*")])
        if fp:
            try:
                with open(fp, 'w') as f:
                    json.dump({
                        "version": 2.0,
                        "pattern_name": self.pattern_name.get(),
                        "pattern_type": self.pattern_type.get(),
                        "canvas_width": self.canvas_width_mm.get(),
                        "canvas_height": self.canvas_height_mm.get(),
                        "grid_size": self.grid_size_mm.get(),
                        "line_weight": self.line_weight.get(),
                        "lines": self.lines,
                    }, f, indent=2)
                messagebox.showinfo("Success", f"Saved: {os.path.basename(fp)}")
            except Exception as e:
                messagebox.showerror("Error", str(e))

    def load_project(self, event=None):
        fp = filedialog.askopenfilename(filetypes=[("HATCH", "*.hatch"), ("JSON", "*.json"), ("All", "*.*")])
        if fp:
            try:
                with open(fp, 'r') as f:
                    data = json.load(f)
                self.pattern_name.set(data.get("pattern_name", "PATTERN_V2"))
                self.pattern_type.set(data.get("pattern_type", "MODEL"))
                self.canvas_width_mm.set(data.get("canvas_width", 4000))
                self.canvas_height_mm.set(data.get("canvas_height", 4000))
                self.grid_size_mm.set(data.get("grid_size", 100))
                self.line_weight.set(data.get("line_weight", 1))
                self.lines = data.get("lines", [])
                self.history.clear()
                self.redo_history.clear()
                self.redraw_all()
                self.generate_pat()
                messagebox.showinfo("Success", f"Loaded: {os.path.basename(fp)}")
            except Exception as e:
                messagebox.showerror("Error", str(e))

    def toggle_grid(self, event=None):
        self.grid_visible.set(not self.grid_visible.get())
        self.draw_grid()

    def toggle_snap(self, event=None):
        self.snap_enabled.set(not self.snap_enabled.get())


