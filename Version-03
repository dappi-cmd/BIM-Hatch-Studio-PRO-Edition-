        """Setup entire UI"""
        self.setup_menu_bar()
        
        workspace = tk.Frame(self.root, bg=self.bg_color)
        workspace.pack(side=tk.TOP, fill=tk.BOTH, expand=True)
        
        self.setup_toolbar(workspace)
