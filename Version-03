        self.root.minsize(1400, 800)
        
        # Professional Dark Theme
        self.bg_color = "#0a0e27"
        self.panel_color = "#141829"
        self.secondary_panel = "#1a1f3a"
        self.text_color = "#e8ecf1"
        self.accent_color = "#00d4ff"
        self.accent_secondary = "#ff6b35"
        self.grid_color = "#2d3561"
        self.grid_light = "#3d4571"
        self.line_color = "#00d4ff"
        self.preview_bg = "#0b0f24"
        self.error_color = "#ff4757"
        self.success_color = "#2ed573"
        self.warning_color = "#ffa502"
        
        self.setup_styles()
        self.root.configure(bg=self.bg_color)
        
        # State Management
        self.lines = []
        self.history = []
        self.redo_history = []
        self.current_shape_id = None
        self.start_x = 0
        self.start_y = 0
        self.is_shift_pressed = False
        self.pan_start_x = 0
        self.pan_start_y = 0
        
        # Variables
        self.current_tool = tk.StringVar(value="LINE")
        self.grid_size_mm = tk.IntVar(value=100)
        self.canvas_width_mm = tk.IntVar(value=4000)
        self.canvas_height_mm = tk.IntVar(value=4000)
        self.pattern_name = tk.StringVar(value="PATTERN_V2")
        self.pattern_type = tk.StringVar(value="MODEL")
        self.line_style = tk.StringVar(value="SOLID")
        self.line_weight = tk.IntVar(value=1)
        self.global_scale = tk.DoubleVar(value=1.0)
        
        # Auto-gen params
        self.brick_w = tk.IntVar(value=200)
        self.brick_h = tk.IntVar(value=100)
        self.pattern_density = tk.IntVar(value=50)
        self.rotation_angle = tk.IntVar(value=0)
        self.offset_x = tk.IntVar(value=0)
        self.offset_y = tk.IntVar(value=0)
        
        self.zoom_level = 1.0
        self.pan_x = 0
        self.pan_y = 0
        self.grid_visible = tk.BooleanVar(value=True)
        self.snap_enabled = tk.BooleanVar(value=True)
        
        self.setup_ui()
        self.setup_key_bindings()
        self.redraw_all()

    def setup_styles(self):
        """Configure TTK styles"""
        style = ttk.Style()
        style.theme_use('default')
        style.configure('TNotebook', background=self.panel_color, borderwidth=0)
        style.configure('TNotebook.Tab', background=self.panel_color, foreground=self.text_color, 
                       padding=[12, 8], font=("Segoe UI", 9, "bold"))
        style.map('TNotebook.Tab', background=[('selected', self.accent_color)])
        style.configure('TFrame', background=self.panel_color)
        style.configure('TLabel', background=self.panel_color, foreground=self.text_color)

    def setup_key_bindings(self):
        """Setup keyboard shortcuts"""
        self.root.bind("<Shift_L>", lambda e: setattr(self, 'is_shift_pressed', True))
        self.root.bind("<KeyRelease-Shift_L>", lambda e: setattr(self, 'is_shift_pressed', False))
        self.root.bind("<Control-z>", self.undo)
        self.root.bind("<Control-y>", self.redo)
        self.root.bind("<Control-s>", self.save_project)
        self.root.bind("<Control-o>", self.load_project)
        self.root.bind("<Control-e>", self.export_pat)
        self.root.bind("<g>", self.toggle_grid)
        self.root.bind("<d>", self.toggle_snap)

